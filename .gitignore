# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Raw activation and state dumps. These are large and stay on the compute box.
# See docs/ARTIFACTS.md for where they live and how to re-attach them.
*.npy
*.npz
*.pt
*.bin
*.safetensors

# Everything else under results/ and data/ IS tracked. Summary JSON, per-turn CSV,
# and the run notes are the provenance chain behind every number in the paper, so
# they belong in git. Do not add a blanket results/ or data/ rule here.

# Secrets
.env

# Logs (regenerated per run)
logs/
.run_logs/
wandb/

# LaTeX build artifacts. Scoped to the paper directory so that run logs and
# notes living under results/ stay tracked.
context_fatigue_paper/*.aux
context_fatigue_paper/*.fdb_latexmk
context_fatigue_paper/*.fls
context_fatigue_paper/*.log
context_fatigue_paper/*.out
context_fatigue_paper/*.synctex.gz
context_fatigue_paper/*.bbl
context_fatigue_paper/*.blg
context_fatigue_paper/*.toc
texput.log

# Scratch
tmp/
temp/
out/
worktrees/

# Claude Code local session artifacts
.claude/
